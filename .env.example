# 쿠키 서명 키. 아무 긴 무작위 문자열이면 된다.
#   openssl rand -base64 32
# 설정하지 않으면 개발용 기본값이 쓰이고, 그 상태로 배포하면 남의 로그인을 위조할 수 있다.
AUTH_SECRET=

# 카카오 로그인 (https://developers.kakao.com)
#   내 애플리케이션 > 앱 키 > REST API 키
#   카카오 로그인 > Redirect URI 에 아래 값을 그대로 등록
# 동의항목은 하나도 켜지 않는다 — 회원번호만 쓰므로 검수가 필요 없다.
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
# 보안 > Client Secret 을 사용으로 켰다면 입력 (선택)
KAKAO_CLIENT_SECRET=
