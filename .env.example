# 쿠키 서명 키. 아무 긴 무작위 문자열이면 된다.
#   openssl rand -base64 32
AUTH_SECRET=

# ── 카카오 로그인 (developers.kakao.com) ──
# REST API 키. 동의항목은 하나도 켜지 않는다 — 회원번호만 쓰므로 검수가 필요 없다.
KAKAO_CLIENT_ID=
# 카카오 앱에 등록한 것과 한 글자도 다르면 안 된다.
#   로컬   http://localhost:3000/api/auth/kakao/callback
#   운영   https://<배포주소>/api/auth/kakao/callback
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
# 카카오 앱에서 'client_secret' 을 켰을 때만 필요하다.
KAKAO_CLIENT_SECRET=

# ── 저장소 (Upstash Redis) ──
# 세션·공유결과·순위표·계정이 여기에 들어간다.
# 비워두면 프로세스 메모리로 동작한다 — 로컬 개발에는 괜찮지만,
# 배포에서는 요청마다 인스턴스가 달라져 세션과 순위표가 깨진다.
# Vercel > Storage > Upstash 로 만들면 이 두 값이 자동으로 들어간다
# (그때는 KV_REST_API_URL / KV_REST_API_TOKEN 이라는 이름으로 들어오는데, 둘 다 읽는다).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
